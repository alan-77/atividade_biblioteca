<%- include("partials/header") %>
    <article class="max-w-2xl mx-auto mt-6">
        <header class="mb-6">
            <hgroup>
                <h2 class="text-3xl font-bold">
                    Cadastrar Livro
                </h2>
                <p class="text-gray-600 mt-2">
                    Adicione um novo livro à sua estante.
                </p>
            </hgroup>
        </header>
        <section class="bg-white rounded-xl shadow-lg p-8">
            <form action="/livros/novo" method="POST">
                <fieldset>
                    <legend class="text-xl font-semibold mb-6">
                        Informações do livro
                    </legend>
                    <section class="mb-5">
                        <label for="titulo" class="block font-medium mb-2">
                            Título do Livro
                        </label>
                        <input type="text" id="titulo" name="titulo" required placeholder="Digite o título do livro"
                            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500">

                    </section>
                    <section class="mb-5">
                        <label for="autor" class="block font-medium mb-2">
                            Autor
                        </label>
                        <input type="text" id="autor" name="autor" required placeholder="Digite o nome do autor"
                            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500">
                    </section>
                    <section class="mb-5">
                        <label for="paginas" class="block font-medium mb-2">
                            Quantidade de Páginas
                        </label>
                        <input type="number" id="paginas" name="paginas" min="1" required placeholder="Ex.: 250"
                            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500">

                    </section>
                </fieldset>
                <menu class="flex gap-3 mt-6">
                    <li>
                        <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">
                            Cadastrar Livro
                        </button>
                    </li>
                    <li>
                        <a href="/livros"
                            class="inline-block bg-gray-200 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-300">
                            Cancelar
                        </a>
                    </li>
                </menu>
            </form>
        </section>
    </article>
    <%- include("partials/footer") %>